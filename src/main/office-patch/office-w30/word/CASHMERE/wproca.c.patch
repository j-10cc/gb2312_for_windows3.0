-/* O L D E S T  C M G */
-/*  makes modules in cmg oldest.
-*/
-/* %%Function:OldestCmg   %%Owner:peterj */
-OldestCmg (cmg)
-int cmg;
-{
-	int iihcd = 0;
-	int ihcd;
-	HANDLE hcd;
-
-	while ((ihcd = mpcmgrgihcd [cmg][iihcd++]) != ihcdEnd)
-		{
-		if ((hcd = rghcdModules[ihcd]) == NULL)
-			continue;
-		StartUMeas (umGlobalLru);
-		GlobalLruOldest (hcd);
-		StopUMeas (umGlobalLru);
-		}
-}
