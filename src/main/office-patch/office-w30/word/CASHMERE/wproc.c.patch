-/* %%Function:FXpNearStyWndBorder  %%Owner:peterj */
-FXpNearStyWndBorder(xp, hwwd)
-int xp;
-struct WWD **hwwd;
-{
-	int xpStyWndBorder = (*hwwd)->xwSelBar;
-
-	return( xp <= xpStyWndBorder &&
-			xp >= xpStyWndBorder - (vsci.dxpBorder << 1));
-}
