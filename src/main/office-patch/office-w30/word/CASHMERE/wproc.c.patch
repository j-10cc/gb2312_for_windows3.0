-ReportFailCalls()
-{
-	if (vdbs.cWinCalls || vdbs.cLmemCalls)
-		{
-		CHAR rgch[cchMaxSz], *pch = rgch;
-		CchPchToPpch(SzShared("\r\nMem calls = "), &pch);
-		CchUnsToPpch(vdbs.cLmemCalls, &pch);
-		CchPchToPpch(SzShared(" Win calls = "), &pch);
-		CchUnsToPpch(vdbs.cWinCalls, &pch);
-		*pch++ = '\r';
-		*pch++ = '\n';
-		*pch = 0;
-		CommSz(rgch);
-		vdbs.cLmemCalls = 0;
-		vdbs.cWinCalls = 0;
-		}
-}
