+HANDNATIVE int UMultDivNR(w, numer, denom)
+unsigned int w, numer, denom;
+{
+	unsigned long result;
+	if (denom == 0)
+		return 0xffff;
+	result = ((unsigned long)w * numer) / denom;
+	return result > 0xffffL ? 0xffff : (int)result;
+}
+HANDNATIVE int FNeChp(pchp1, pchp2)
+int *pchp1, *pchp2;
