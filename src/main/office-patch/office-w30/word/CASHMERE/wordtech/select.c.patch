+/* The document CP counts bytes, while a GB2312 character occupies two CPs.
+ * Keep character-style selections out of the interval between its bytes. */
+#ifdef WIN
+int FWordGbMid(doc, cp)
+int doc;
+CP cp;
+{
+	CP cpRun, cpScan;
+	int ch;
+	if (cp <= cp0 || cp >= CpMacDocEdit(doc))
+		return fFalse;
+	if (!FWordGbTrail(ChFetch(doc, cp, fcmChars)) ||
+		!FWordGbLead(ChFetch(doc, cp-1, fcmChars)))
+		return fFalse;
+	/* A trail byte may itself be a legal lead.  Establish parity from the
+	 * nearest preceding non-GB byte instead of examining only cp-1/cp. */
+	cpRun = cp;
+	while (cpRun > cp0 && FWordGbTrail(ChFetch(doc, cpRun-1, fcmChars)))
+		cpRun--;
+	for (cpScan = cpRun; cpScan < cp; )
+		{
+		ch = ChFetch(doc, cpScan, fcmChars);
+		if (FWordGbLead(ch) && cpScan + 1 <= cp &&
+			FWordGbTrail(ChFetch(doc, cpScan+1, fcmChars)))
+			cpScan += 2;
+		else
+			cpScan++;
+		}
+	return cpScan > cp;
+}
+
+STATIC CP NEAR CpWordGbFirst(doc, cp)
+int doc;
+CP cp;
+{
+	return FWordGbMid(doc, cp) ? cp-1 : cp;
+}
+
+CP CpWordGbLim(doc, cp)
+int doc;
+CP cp;
+{
+	return FWordGbMid(doc, cp) ? cp+1 : cp;
+}
+#endif
