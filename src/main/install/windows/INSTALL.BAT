@ECHO OFF
IF "%1"=="CGA" GOTO MODEOK
IF "%1"=="VGA" GOTO MODEOK
:USAGE
ECHO Usage: INSTALL CGA D:\WINDOWS or INSTALL VGA D:\WINDOWS
GOTO END
:MODEOK
IF "%2"=="" GOTO USAGE
ECHO [1/7] Starting installation...
ECHO [2/7] Preparing destination...
GBPATH CHECK %2
IF ERRORLEVEL 1 GOTO BADTARGET
COPY SETUP.INF SETUP.BAK > NUL
IF ERRORLEVEL 1 GOTO FAILED
ECHO [3/7] Preparing Setup paths...
GBPATH MEDIA %1 %2
IF NOT EXIST GBMED.OK GOTO FAILED
MD %2
IF ERRORLEVEL 1 GOTO FAILED
MD %2\SYSTEM
IF ERRORLEVEL 1 GOTO FAILED
COPY CFSUNG.FON %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY CFSUNG16.B5Q %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
IF "%1"=="VGA" COPY CVDDCVGA.386 %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
IF "%1"=="CGA" GOTO CGAFONT
GOTO RUNSETUP
:CGAFONT
COPY CHCGA10.FNT %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY CHCGA12.FNT %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY CGAS12.FON %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY CHCGA08.FNT %2\SYSTEM > NUL
IF ERRORLEVEL 1 GOTO FAILED
